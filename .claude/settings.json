{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "showThinkingSummaries": false,
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "64000",
    "ENABLE_TOOL_SEARCH": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "PATH": "/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Agent",
      "AskUserQuestion",
      "Bash(ast-grep:*)",
      "Bash(awk:*)",
      "Bash(basename:*)",
      "Bash(bash -n:*)",
      "Bash(black:*)",
      "Bash(bun*)",
      "Bash(cat:*)",
      "Bash(comm:*)",
      "Bash(coverage:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(dirname:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(env:*)",
      "Bash(eslint:*)",
      "Bash(false:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(flake8:*)",
      "Bash(gh api -X GET:*)",
      "Bash(gh auth status:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(git add:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git cat-file:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git config:*)",
      "Bash(git count-objects:*)",
      "Bash(git describe:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git fsck:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git remote:*)",
      "Bash(git rev-list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git revert:*)",
      "Bash(git shortlog:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git status:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(make:*)",
      "Bash(man:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(mypy:*)",
      "Bash(node*)",
      "Bash(npm*)",
      "Bash(npx*)",
      "Bash(pip*)",
      "Bash(pip3:*)",
      "Bash(pnpm*)",
      "Bash(prettier:*)",
      "Bash(printf:*)",
      "Bash(pwd:*)",
      "Bash(pydoc:*)",
      "Bash(pylint:*)",
      "Bash(pytest:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(readlink:*)",
      "Bash(realpath:*)",
      "Bash(rg:*)",
      "Bash(ruff:*)",
      "Bash(sed:*)",
      "Bash(seq:*)",
      "Bash(sg:*)",
      "Bash(sh -n:*)",
      "Bash(sha256sum:*)",
      "Bash(shasum:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(time:*)",
      "Bash(touch:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(true:*)",
      "Bash(type:*)",
      "Bash(uniq:*)",
      "Bash(uv*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(xargs:*)",
      "Bash(yarn*)",
      "Bash(yq:*)",
      "BashOutput",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Edit",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "Glob",
      "Grep",
      "KillShell",
      "ListMcpResourcesTool",
      "MultiEdit",
      "NotebookEdit",
      "Read",
      "ReadMcpResourceTool",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__context7__get-library-docs",
      "mcp__context7__resolve-library-id",
      "mcp__sequential-thinking__*"
    ],
    "ask": [
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api -X POST:*)",
      "Bash(gh api -X PUT:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh secret:*)",
      "Bash(git push:*)",
      "Bash(launchctl:*)",
      "Bash(rm:*)",
      "Bash(sudo:*)",
      "Edit(./dashboard/scripts/**)"
    ],
    "deny": [
      "Bash(Clear-Disk:*)",
      "Bash(DELETE FROM:*)",
      "Bash(DROP DATABASE:*)",
      "Bash(DROP TABLE:*)",
      "Bash(Format-Volume:*)",
      "Bash(Remove-Item -Recurse -Force C\\:/:*)",
      "Bash(TRUNCATE:*)",
      "Bash(chmod -R 777:*)",
      "Bash(chmod 777:*)",
      "Bash(dd:*)",
      "Bash(del /S /Q C\\:/:*)",
      "Bash(fdisk:*)",
      "Bash(format:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git rebase -i:*)",
      "Bash(git reset --hard:*)",
      "Bash(init:*)",
      "Bash(kill -9:*)",
      "Bash(killall:*)",
      "Bash(mkfs:*)",
      "Bash(mongo:*)",
      "Bash(mongosh:*)",
      "Bash(mysql -e DROP:*)",
      "Bash(psql -c DROP:*)",
      "Bash(reboot:*)",
      "Bash(redis-cli FLUSHALL:*)",
      "Bash(redis-cli FLUSHDB:*)",
      "Bash(rm -rf /*:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf C\\:/*:*)",
      "Bash(rm -rf C\\:/:*)",
      "Bash(rm -rf ~/*:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rmdir /S /Q C\\:/:*)",
      "Bash(shutdown:*)",
      "Bash(systemctl:*)",
      "Edit(./.env)",
      "Edit(./dashboard/.cache/**)",
      "Edit(./secrets/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.ssh/**)",
      "Glob(./.env)",
      "Glob(./secrets/**)",
      "Glob(~/.aws/**)",
      "Glob(~/.config/gcloud/**)",
      "Glob(~/.ssh/**)",
      "Grep(./.env)",
      "Grep(./secrets/**)",
      "Grep(~/.aws/**)",
      "Grep(~/.config/gcloud/**)",
      "Grep(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./dashboard/.cache/**)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.ssh/**)",
      "Write(./.env)",
      "Write(./dashboard/.cache/**)",
      "Write(./secrets/**)",
      "Write(~/.aws/**)",
      "Write(~/.config/gcloud/**)",
      "Write(~/.ssh/**)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "respectGitignore": true,
  "teammateMode": "auto",
  "effortLevel": "medium",
  "includeGitInstructions": true,
  "disableBypassPermissionsMode": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-secrets.sh\"",
            "timeout": 15,
            "statusMessage": "비밀값 검사"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive.sh\"",
            "timeout": 15,
            "statusMessage": "되돌릴 수 없는 작업 검사"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-gate.sh\"",
            "timeout": 300,
            "statusMessage": "검증 게이트"
          }
        ]
      }
    ]
  }
}
